# =========================================================================
# Variables de entorno para Vercel — Kiki's Collection Shop
# =========================================================================
# Estas variables se configuran en Vercel (NO se suben a GitHub).
# Ve a: vercel.com → tu proyecto → Settings → Environment Variables
#
# IMPORTANTE: NUNCA pongas las llaves secretas (sk_..., APP_USR-... access token)
# en config.js o en el código. Solo van aquí, en Vercel.
# =========================================================================

# ---- Mercado Pago ----
# Access Token de producción (empieza con APP_USR-...)
# Se obtiene en: https://www.mercadopago.com.mx → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=APP_USR-aqui_tu_access_token_de_produccion

# ---- Stripe ----
# Secret key de producción (empieza con sk_live_...)
# Se obtiene en: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_aqui_tu_secret_key_de_produccion

# ---- Opcional: URL base de la tienda ----
# Solo necesario si tu dominio es diferente
URL_BASE=https://www.kikicollectionshop.com

# =========================================================================
# Flujo post-pago (historial, correo y guía de envío)
# =========================================================================

# ---- Supabase (server-side, para los webhooks/verify que confirman el pago) ----
# SUPABASE_URL es la misma URL pública de config.js (pública).
# SUPABASE_SERVICE_ROLE_KEY es la SERVICE ROLE KEY (SECRETA, NUNCA en el navegador
# ni en config.js). Cópiala de Supabase → Settings → API → service_role key.
# Permite a los endpoints marcar el pedido como pagado sin sesión de usuario.
SUPABASE_URL=https://uxjokvkjwbdyuunqflca.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ..._service_role_key_aqui

# ---- Correo del resumen del pedido (Resend) ----
# Crea cuenta en https://resend.com y verifica tu dominio kikicollectionshop.com.
# RESEND_API_KEY empieza con re_... (SECRETA).
# FROM_EMAIL debe usar un dominio verificado en Resend.
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=Kiki's Collection Shop <tienda@kikicollectionshop.com>

# ---- Webhook de Stripe (opcional pero recomendado) ----
# Solo si registras el webhook en Stripe Dashboard. Sirve para confirmar pagos
# asíncronamente (aunque el cliente cierre la pestaña antes de volver).
# Cópialo de Stripe → Developers → Webhooks → tu endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
