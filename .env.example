# =========================================================================
# Variables de entorno para Vercel — Kiki's Collection Shop
# =========================================================================
# Estas variables se configuran en Vercel (NO se suben a GitHub).
# Ve a: vercel.com → tu proyecto → Settings → Environment Variables
#
# IMPORTANTE: NUNCA pongas las llaves secretas (sk_..., APP_USR-... access token)
# en config.js o en el código. Solo van aquí, en Vercel.
# =========================================================================

# ---- Mercado Pago ----
# Access Token de producción (empieza con APP_USR-...)
# Se obtiene en: https://www.mercadopago.com.mx → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=APP_USR-4967955692480131-112619-3c89d23cea4702b429084350dd794658-3659789423

# ---- Stripe ----
# Secret key de producción (empieza con sk_live_...)
# Se obtiene en: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=mk_1Ss2pCH9W4wWnmh2zV0lfpIy

# ---- Opcional: URL base de la tienda ----
# Solo necesario si tu dominio es diferente
URL_BASE=https://www.kikicollectionshop.com
